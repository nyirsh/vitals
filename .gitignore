# Each project ignores its own build output (vita/.gitignore, ps3/.gitignore); this is for the root
.*
!.gitignore
!.vscode
__pycache__/

# Dumps from the consoles (firmware modules, CA files, memory segments): Sony's, never committed;
# a folder per console and firmware (dumps/ps3/4.93-cex, dumps/vita/3.65), where the tools and tests read them
/dumps/
