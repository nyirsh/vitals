     const mbedtls_x509_crt *MBEDTLS_PRIVATE(dn_hints);/*!< acceptable client cert issuers    */
 #endif
+
+    /* vitals: a client's callback for a server's certificate request, with its CA names */
+    int(*MBEDTLS_PRIVATE(f_cert_request))(void *, mbedtls_ssl_context *, const unsigned char *, size_t);
+    void *MBEDTLS_PRIVATE(p_cert_request);
 };
 
