--- a/library/ssl_tls.c
+++ b/library/ssl_tls.c
@@ -1802,6 +1802,36 @@
     conf->offer_unknown_ciphersuites = enable != 0;
 }
 
+void mbedtls_ssl_conf_cert_request_cb(mbedtls_ssl_config *conf,
+                                      int (*f_cert_request)(void *, mbedtls_ssl_context *,
+                                                            const unsigned char *, size_t),
+                                      void *p_cert_request)
+{
+    conf->f_cert_request = f_cert_request;
+    conf->p_cert_request = p_cert_request;
+}
+
+int mbedtls_ssl_vitals_cert_request(mbedtls_ssl_context *ssl, const unsigned char *names,
+                                    size_t length)
+{
+    int ret;
+
+    if (ssl->conf->f_cert_request == NULL) {
+        return 0;
+    }
+    ret = ssl->conf->f_cert_request(ssl->conf->p_cert_request, ssl, length > 0 ? names : NULL,
+                                    length);
+    if (ret != 0) {
+        return ret;
+    }
+#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)
+    if (ssl->handshake->sni_key_cert != NULL) {
+        ssl->handshake->key_cert = ssl->handshake->sni_key_cert;
+    }
+#endif
+    return 0;
+}
+
 void mbedtls_ssl_conf_ciphersuites(mbedtls_ssl_config *conf,
                                    const int *ciphersuites)
