+
+/**
+ * \brief          vitals: on a client, f_cert_request is called when the server asks for a
+ *                 certificate (TLS 1.2's CertificateRequest, TLS 1.3's), with the CA names it
+ *                 accepts as the message has them: each a 2-byte length, then a DER Name (NULL
+ *                 and 0 when it gives none). A certificate it gives mbedtls_ssl_set_hs_own_cert()
+ *                 is the one sent, in place of mbedtls_ssl_conf_own_cert()'s; a non-zero return
+ *                 fails the handshake with it.
+ *
+ * \param conf     SSL configuration
+ * \param f_cert_request The callback, or NULL
+ * \param p_cert_request Its first argument
+ */
+void mbedtls_ssl_conf_cert_request_cb(mbedtls_ssl_config *conf,
+                                      int (*f_cert_request)(void *, mbedtls_ssl_context *,
+                                                            const unsigned char *, size_t),
+                                      void *p_cert_request);
 
