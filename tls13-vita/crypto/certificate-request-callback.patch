vitals-ssl: a client callback for a server's certificate request, with the CA names it
accepts (TLS 1.2's CertificateRequest and TLS 1.3's certificate_authorities extension), whose
certificate for the handshake is the one sent, so a connection picks its client certificate as
Sony's libssl does (vitals-ssl/src/connection.c). Applied to the Mbed TLS 4.2 release, after
rsa-client.patch and offer-unknown-ciphersuites.patch, by crypto/apply_patch.cmake

--- a/include/mbedtls/ssl.h
+++ b/include/mbedtls/ssl.h
@@ -1586,6 +1586,10 @@
     const mbedtls_x509_crt *MBEDTLS_PRIVATE(dn_hints);/*!< acceptable client cert issuers    */
 #endif
 
+    /* vitals: a client's callback for a server's certificate request, with its CA names */
+    int(*MBEDTLS_PRIVATE(f_cert_request))(void *, mbedtls_ssl_context *, const unsigned char *, size_t);
+    void *MBEDTLS_PRIVATE(p_cert_request);
+
     mbedtls_ssl_unused_data_t MBEDTLS_PRIVATE(unused);
 };
 
@@ -3335,6 +3339,23 @@
  */
 void mbedtls_ssl_conf_ciphersuites(mbedtls_ssl_config *conf,
                                    const int *ciphersuites);
+
+/**
+ * \brief          vitals: on a client, f_cert_request is called when the server asks for a
+ *                 certificate (TLS 1.2's CertificateRequest, TLS 1.3's), with the CA names it
+ *                 accepts as the message has them: each a 2-byte length, then a DER Name (NULL
+ *                 and 0 when it gives none). A certificate it gives mbedtls_ssl_set_hs_own_cert()
+ *                 is the one sent, in place of mbedtls_ssl_conf_own_cert()'s; a non-zero return
+ *                 fails the handshake with it.
+ *
+ * \param conf     SSL configuration
+ * \param f_cert_request The callback, or NULL
+ * \param p_cert_request Its first argument
+ */
+void mbedtls_ssl_conf_cert_request_cb(mbedtls_ssl_config *conf,
+                                      int (*f_cert_request)(void *, mbedtls_ssl_context *,
+                                                            const unsigned char *, size_t),
+                                      void *p_cert_request);
 
