vitals-http: lets a configuration offer cipher suites Mbed TLS doesn't implement, so a ClientHello
can list the console's 3DES and RC4 suites as its own TLS does (vitals-http/src/tls.c). Applied to
the Mbed TLS 3.6 release by crypto/apply_patch.cmake

--- a/include/mbedtls/ssl.h
+++ b/include/mbedtls/ssl.h
@@ -1528,6 +1528,8 @@
 
     /** Allowed ciphersuites for (D)TLS 1.2 (0-terminated)                  */
     const int *MBEDTLS_PRIVATE(ciphersuite_list);
+    /* vitals-http: offer the suites of the list this library doesn't implement, as given */
+    unsigned char MBEDTLS_PRIVATE(offer_unknown_ciphersuites);
 
 #if defined(MBEDTLS_SSL_PROTO_TLS1_3)
     /** Allowed TLS 1.3 key exchange modes.                                 */
@@ -3501,6 +3503,16 @@
  */
 void mbedtls_ssl_conf_ciphersuites(mbedtls_ssl_config *conf,
                                    const int *ciphersuites);
+
+/**
+ * \brief          vitals-http: also offer, in the ClientHello, the suites of the list set with
+ *                 mbedtls_ssl_conf_ciphersuites() this library doesn't implement, at their place
+ *                 in it. A server that chooses one of them fails the handshake.
+ *
+ * \param conf     SSL configuration
+ * \param enable   1 to offer them, 0 to leave them out (the default)
+ */
+void mbedtls_ssl_conf_offer_unknown_ciphersuites(mbedtls_ssl_config *conf, int enable);
 
 #if defined(MBEDTLS_SSL_PROTO_TLS1_3)
 /**
--- a/library/ssl_client.c
+++ b/library/ssl_client.c
@@ -358,6 +358,14 @@
 
         ciphersuite_info = mbedtls_ssl_ciphersuite_from_id(cipher_suite);
 
+        /* vitals-http: a suite this library doesn't have, offered as given */
+        if (ciphersuite_info == NULL && ssl->conf->offer_unknown_ciphersuites) {
+            MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2);
+            MBEDTLS_PUT_UINT16_BE(cipher_suite, p, 0);
+            p += 2;
+            continue;
+        }
+
         if (mbedtls_ssl_validate_ciphersuite(ssl, ciphersuite_info,
                                              ssl->handshake->min_tls_version,
                                              ssl->tls_version) != 0) {
--- a/library/ssl_tls.c
+++ b/library/ssl_tls.c
@@ -1797,6 +1797,11 @@
 }
 #endif /* MBEDTLS_SSL_CLI_C */
 
+void mbedtls_ssl_conf_offer_unknown_ciphersuites(mbedtls_ssl_config *conf, int enable)
+{
+    conf->offer_unknown_ciphersuites = enable != 0;
+}
+
 void mbedtls_ssl_conf_ciphersuites(mbedtls_ssl_config *conf,
                                    const int *ciphersuites)
 {
