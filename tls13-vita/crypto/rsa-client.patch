+#if defined(MBEDTLS_KEY_EXCHANGE_RSA_ENABLED)
+/* Client-only RSA key exchange from RFC 5246, using TF-PSA-Crypto's public API.
+ * No RSA server decryption path or asynchronous decryption ABI is restored. */
 MBEDTLS_CHECK_RETURN_CRITICAL
+static int ssl_write_encrypted_pms(mbedtls_ssl_context *ssl, size_t offset,
+                                   size_t *olen, size_t pms_offset)
+{
+    mbedtls_pk_context *peer_pk;
+    unsigned char *pms = ssl->handshake->premaster + pms_offset;
+    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;
+    int ret;
+    psa_status_t status;
+    if (offset + 2 > MBEDTLS_SSL_OUT_CONTENT_LEN ||
+        pms_offset + 48 > sizeof(ssl->handshake->premaster))
+        return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;
+    mbedtls_ssl_write_version(pms, ssl->conf->transport, MBEDTLS_SSL_VERSION_TLS1_2);
+    status = psa_generate_random(pms + 2, 46);
+    if (status != PSA_SUCCESS) return MBEDTLS_ERR_SSL_HW_ACCEL_FAILED;
+    ssl->handshake->pmslen = 48;
+#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)
+    if (ssl->session_negotiate->peer_cert == NULL) return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+    peer_pk = &ssl->session_negotiate->peer_cert->pk;
+#else
+    peer_pk = &ssl->handshake->peer_pubkey;
+#endif
+    if (!mbedtls_pk_can_do_psa(peer_pk, PSA_ALG_RSA_PKCS1V15_CRYPT, PSA_KEY_USAGE_ENCRYPT))
+        return MBEDTLS_ERR_SSL_PK_TYPE_MISMATCH;
+    ret = mbedtls_pk_get_psa_attributes(peer_pk, PSA_KEY_USAGE_ENCRYPT, &attributes);
+    if (ret == 0) {
+        psa_set_key_algorithm(&attributes, PSA_ALG_RSA_PKCS1V15_CRYPT);
+        ret = mbedtls_pk_import_into_psa(peer_pk, &attributes, &key);
+    }
+    psa_reset_key_attributes(&attributes);
+    if (ret != 0) return ret;
+    status = psa_asymmetric_encrypt(key, PSA_ALG_RSA_PKCS1V15_CRYPT, pms, 48, NULL, 0,
+                                    ssl->out_msg + offset + 2,
+                                    MBEDTLS_SSL_OUT_CONTENT_LEN - offset - 2, olen);
+    psa_status_t destroyed = psa_destroy_key(key);
+    if (status != PSA_SUCCESS || destroyed != PSA_SUCCESS) return MBEDTLS_ERR_SSL_HW_ACCEL_FAILED;
+    MBEDTLS_PUT_UINT16_BE(*olen, ssl->out_msg, offset);
+    *olen += 2;
+#if !defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)
+    mbedtls_pk_free(peer_pk);
+#endif
+    return 0;
+}
