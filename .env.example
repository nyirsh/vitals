# Your consoles, for each project's tools: cp .env.example .env, then set the addresses
# The Vita, for make upload-app, log, app-log, fetch and status (vita/tools/vita_comms.py): VitaShell shows its
# address when SELECT starts its FTP server
VITA_HOST=192.168.1.100
# VitaShell's FTP server, if not on its usual port
#VITA_PORT=1337
# The PS3, for make install, upload-app, reboot, log, app-log, fetch, status and uninstall (ps3/tools/ps3_comms.py)
PS3_HOST=192.168.1.100
# webMAN MOD's FTP and web servers, if not on their usual ports
#PS3_PORT=21
#PS3_HTTP_PORT=80
